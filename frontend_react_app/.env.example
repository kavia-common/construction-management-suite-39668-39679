# Frontend environment variables
# Backend API base URL (no trailing slash)
REACT_APP_API_BASE_URL=http://localhost:8000

# Site URL for redirects (Supabase auth, etc.)
REACT_APP_SITE_URL=http://localhost:3000

# Supabase (optional; app runs without it but auth features require these)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Plaid (Frontend)
# NOTE: Do NOT put secret keys in the frontend. These are only flags/configs.
# All secure token exchanges happen in the backend.
# If your backend supports products/country customization via query/body,
# leave these empty here. Kept for potential feature flags.
REACT_APP_PLAID_ENV=sandbox
