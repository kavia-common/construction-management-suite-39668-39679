# Frontend environment example for Construction Management Suite - React App

# Base URL for backend API (FastAPI). Example: http://localhost:8000 or https://api.example.com
REACT_APP_API_BASE_URL=http://localhost:8000

# Site URL for auth flows (used for Supabase emailRedirectTo)
REACT_APP_SITE_URL=http://localhost:3000

# Supabase configuration (required for enabling auth and future data usage)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
